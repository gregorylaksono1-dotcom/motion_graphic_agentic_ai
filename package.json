{
  "name": "motion-graphic-agent",
  "version": "1.0.0",
  "description": "Agentic AI for Remotion React Code Generation with MCP Integration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "generate": "tsx src/cli.ts",
    "preview": "remotion preview output/index.ts",
    "render": "tsx src/render.ts",
    "demo": "tsx src/demo.ts",
    "remix": "tsx src/remix.ts",
    "styles": "tsx src/index.ts --list-styles",
    "demo:evidence": "tsx src/demo-evidence.ts",
    "preview:evidence": "remotion preview output-evidence/index.ts",
    "avatar:prepare": "python3 tools/avatar_prepare.py",
    "demo:genome": "tsx src/demo-genome.ts"
  },
  "keywords": [
    "agentic-ai",
    "remotion",
    "mcp",
    "code-generation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/openai": "^4.0.111",
    "@google/genai": "^3.0.0",
    "@langchain/anthropic": "^1.6.1",
    "@langchain/core": "^1.3.5",
    "@langchain/google-genai": "^2.3.5",
    "@langchain/mcp-adapters": "^2.0.2",
    "@langchain/openai": "^1.8.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@remotion/google-fonts": "^4.0.542",
    "ai": "^7.0.166",
    "dotenv": "^18.0.10",
    "langchain": "^1.6.3",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.542",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
