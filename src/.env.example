# Provider options: "openai" | "anthropic" | "google" | "openrouter" | "ollama" | "custom"
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o

# OpenAI / OpenAI-Compatible (Ollama, LM Studio, Groq, Together, vLLM)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# OpenRouter (Unified router for 100+ models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama local endpoint (if using local LLMs)
OLLAMA_BASE_URL=http://localhost:11434/api

